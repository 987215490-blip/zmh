; Delay Chain Summary                                                                     ;
+---------+----------+---------------+---------------+-----------------------+-----+------+
; Name    ; Pin Type ; Pad to Core 0 ; Pad to Core 1 ; Pad to Input Register ; TCO ; TCOE ;
+---------+----------+---------------+---------------+-----------------------+-----+------+
; key1    ; Input    ; --            ; --            ; --                    ; --  ; --   ;
; key2    ; Input    ; --            ; --            ; --                    ; --  ; --   ;
; trig    ; Output   ; --            ; --            ; --                    ; --  ; --   ;
; led0    ; Output   ; --            ; --            ; --                    ; --  ; --   ;
